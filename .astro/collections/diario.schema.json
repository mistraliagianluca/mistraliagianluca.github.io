{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "titolo": {
      "type": "string"
    },
    "data": {
      "type": "string",
      "format": "date-time"
    },
    "lingua": {
      "type": "string",
      "enum": [
        "it",
        "en"
      ]
    },
    "chiave": {
      "type": "string"
    },
    "immagine": {
      "type": "string"
    },
    "estratto": {
      "type": "string"
    },
    "esempio": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "titolo",
    "data",
    "lingua",
    "chiave",
    "immagine",
    "estratto"
  ]
}