---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import { t, paths, prezzi, info, getPromo, prezzoMinimo, fmtDate, u, fotoGalleria, isoData, type Lang } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const promo = getPromo();
const waUrl = `https://wa.me/${info.whatsapp}?text=${encodeURIComponent(t(lang, 'wa_generic'))}`;

// Articoli del Diario: i più recenti, esclusi esempi e nascosti. Quelli con l'evento già concluso li toglie il browser
// (in base alla data di oggi), che poi mostra i primi 3 rimasti: per questo qui se ne preparano fino a 9.
const posts = (await getCollection('diario', ({ data }) => data.lingua === lang && !data.esempio && !data.nascosto))
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 9);

const seasons = ['B', 'M', 'A'] as const;

// Foto di apertura: percorso di un'immagine (o vecchio numero della galleria); se il file non c'è, la foto di riserva.
// Maiuscole e minuscole nel nome del file non contano (SER.JPG = SER.jpg).
const galDir = 'public/assets/gallery';
const trovaFoto = (v: string | number) => {
  const p = fotoGalleria(v);
  const nome = p.split('/').pop()!.toLowerCase();
  const found = fs.existsSync(galDir) ? fs.readdirSync(galDir).find((x) => x.toLowerCase() === nome) : undefined;
  return found ? `/assets/gallery/${found}` : null;
};
const heroSrc = trovaFoto(info.fotoApertura) ?? fotoGalleria(info.fotoAperturaRiserva);

// Periodi di ogni stagione, ricavati dal calendario dell'ultimo anno in prezzi.json
const stagioni = prezzi.stagioni as any;
const anni = Object.keys(stagioni).filter((k) => /^\d{4}$/.test(k)).sort();
const annoPeriodi = anni[anni.length - 1];
const periodi: Record<string, string[]> = { B: [], M: [], A: [] };
{
  const fmtD = (d: Date) => d.toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
  let cur = '', start: Date | null = null, prev: Date | null = null;
  const close = () => { if (cur && start && prev) periodi[cur].push(start.getTime() === prev.getTime() ? fmtD(start) : `${fmtD(start)} – ${fmtD(prev)}`); };
  for (let m = 1; m <= 12; m++) {
    const row: string = stagioni[annoPeriodi][String(m).padStart(2, '0')] ?? '';
    for (let d = 1; d <= row.length; d++) {
      const c = row[d - 1];
      const date = new Date(Date.UTC(Number(annoPeriodi), m - 1, d));
      if (c !== cur) { close(); cur = c; start = date; }
      prev = date;
    }
  }
  close();
}
const planKey = (id: string) => `plan_${id}`;

// Dati per il calcolatore (letti dallo script nel browser)
const calcData = {
  lang,
  whatsapp: info.whatsapp,
  prezzoGiorno: prezzi.prezzoGiorno,
  minimoGiorni: prezzi.minimoGiorni,
  minimoEccezioni: prezzi.minimoEccezioni,
  stagioni: prezzi.stagioni,
  piani: prezzi.piani.map((p) => ({ ...p, nome: t(lang, planKey(p.id)) })),
  servizio: { importo: prezzi.servizio.importo, nome: prezzi.servizio[lang] },
  extra: prezzi.extra.map((e) => ({ id: e.id, importo: e.importo, nome: e[lang] })),
  promo,
  txt: Object.fromEntries(
    ['season_B', 'season_M', 'season_A', 'calc_days', 'calc_season_line', 'calc_plan_line', 'calc_promo_line',
     'calc_err_dates', 'calc_err_order', 'calc_err_min', 'wa_hello', 'wa_dates', 'wa_plan', 'wa_people',
     'wa_total', 'wa_promo', 'wa_name', 'wa_notes', 'calc_service_line', 'wa_extras'].map((k) => [k, t(lang, k)]),
  ),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Mistralia – Noleggio camper',
  url: 'https://www.mistralia.co/',
  telephone: info.telefoni[0],
  email: info.email,
  address: { '@type': 'PostalAddress', streetAddress: 'Strada Statale 96, km 115,500', postalCode: '70026', addressLocality: 'Modugno', addressRegion: 'BA', addressCountry: 'IT' },
  priceRange: `€${prezzoMinimo}–€${Math.max(...Object.values(prezzi.prezzoGiorno))} / giorno`,
};
const extraFm = (n: number) => n.toLocaleString(lang === 'it' ? 'it-IT' : 'en-GB');
const galleria = info.galleria.map((v) => u(fotoGalleria(v)));

// Icone (tratto semplice, 24×24) per "Perché" e per i gruppi del kit. Ogni gruppo del kit può scegliere la sua
// icona nel pannello (campo "icona"); se manca si usa quella nella stessa posizione di questo elenco.
const ICONE: Record<string, string> = {
  carburante: 'M4 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16M3 21h12M4 10h10M14 8h2a2 2 0 0 1 2 2v6a1.5 1.5 0 0 0 3 0V8l-3-3',
  benvenuto: 'M4 8h12v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8zM16 10h1.5a2.5 2.5 0 0 1 0 5H16M8 2v3M12 2v3',
  sicurezza: 'M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3zM9 12l2 2 4-4',
  energia: 'M13 2L4 14h7l-1 8 9-12h-7l1-8z',
  cucina: 'M3 11h18M5 11v6a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3v-6M9 7c0-1.5 1-2 1-3.5M14 7c0-1.5 1-2 1-3.5M1 11h2M21 11h2',
  relax: 'M12 3v2M12 19v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M3 12h2M19 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z',
  igiene: 'M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z',
  comfort: 'M12 2v20M4 6l16 12M20 6L4 18M9 3l3 2 3-2M9 21l3-2 3 2',
  incluso: 'M20 6L9 17l-5-5',
  affidabile: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4 2.5-2.5z',
  spazio: 'M3 18v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6M3 15h18M3 18v2M21 18v2M6 10V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3',
};
const ORDINE_KIT = ['carburante', 'benvenuto', 'sicurezza', 'energia', 'cucina', 'relax', 'igiene', 'comfort'];
const icona = (k: string) => ICONE[k] ?? ICONE.incluso;
---
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- APERTURA -->
<section class="hero">
  <div class="wrap hero-grid">
    <img class="hero-logo" src={u('/assets/brand/logo.png')} alt="Mistralia" width="900" height="677" />
    <div class="hero-photo">
      <img src={u(heroSrc)} alt="Kentucky" width="1264" height="848" fetchpriority="high" />
    </div>
    <div class="hero-text">
      <p class="eyebrow">{t(lang, 'kicker')}</p>
      <h1>{t(lang, 'hero_title')}</h1>
      <p class="hero-sub">{t(lang, 'hero_sub')}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#calcola">{t(lang, 'cta_quote')}</a>
        <span class="from-price">{t(lang, 'from_price', { p: prezzoMinimo })}</span>
      </div>
      <a class="onboard" href="#incluso">
        <strong>{t(lang, 'onboard_title')}</strong>
        <ul>
          {[['carburante', 'onboard_fuel'], ['cucina', 'onboard_kitchen'], ['energia', 'onboard_offgrid'], ['sicurezza', 'onboard_assist']].map(([ic, k]) => (
            <li><span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icona(ic)} /></svg></span>{t(lang, k)}</li>
          ))}
        </ul>
        <span class="onboard-more">{t(lang, 'onboard_more')} →</span>
      </a>
    </div>
  </div>
</section>

<!-- PERCHÉ -->
<section id="perche" class="why">
  <div class="wrap">
    <h2 class="sr-only">{t(lang, 'why_title')}</h2>
    <ul class="why-list">
      {[['incluso', 1], ['affidabile', 2], ['spazio', 3]].map(([ic, n]) => (
        <li>
          <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icona(String(ic))} /></svg></span>
          <div><h3>{t(lang, `why_${n}_t`)}</h3><p>{t(lang, `why_${n}_b`)}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- DIARIO (in alto: è la parte che cambia ogni settimana) -->
{posts.length > 0 && (
  <section id="diario" class="journal">
    <div class="wrap">
      <div class="head-row">
        <h2>{t(lang, 'journal_title')}</h2>
        <p class="section-sub">{t(lang, 'journal_sub')}</p>
      </div>
      <div class="posts">
        {posts.map((p) => (
          <a class="post-card" href={paths.post(lang, p.data.chiave)} data-scadenza={isoData(p.data.scadenza)} hidden>
            <img src={u(p.data.immagine)} alt="" loading="lazy" width="400" height="225" />
            <div>
              <small>{fmtDate(p.data.data, lang)}</small>
              <h3>{p.data.titolo}</h3>
              <p>{p.data.estratto}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- COSA È INCLUSO -->
<section id="incluso" class="included">
  <div class="wrap">
    <h2>{t(lang, 'included_title')}</h2>
    <p class="section-sub">{t(lang, 'included_sub')}</p>
    <ul class="kit">
      {info.kit.map((k: any, i: number) => (
        <li>
          <span class="ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icona(k.icona ?? ORDINE_KIT[i % ORDINE_KIT.length])} /></svg></span>
          <div><h3>{k.titolo[lang]}</h3><p>{k.voci[lang]}</p></div>
        </li>
      ))}
    </ul>
    <p class="kit-not">{t(lang, 'kit_not_included')}</p>
    <div class="prep">
      <h3>{t(lang, 'prep_title')}</h3>
      <ul class="ticks">{info.preparazione[lang].map((v) => <li>{v}</li>)}</ul>
    </div>
  </div>
</section>

<!-- PREZZI -->
<section id="prezzi" class="prices">
  <div class="wrap">
    <h2>{t(lang, 'prices_title')}</h2>
    <p class="section-sub">{t(lang, 'prices_sub')}</p>

    <h3 class="step">{t(lang, 'step1_title')}</h3>
    <div class="seasons">
      {seasons.map((s) => (
        <div class={`season season-${s}`}>
          <div class="season-top"><span><i></i>{t(lang, `season_${s}`)}</span><strong>€{prezzi.prezzoGiorno[s]}<small>/{t(lang, 'per_day_short')}</small></strong></div>
          <p>{periodi[s].join(' · ')}</p>
        </div>
      ))}
    </div>
    <p class="note">{t(lang, 'periods_label', { y: annoPeriodi })} · {t(lang, 'min_days')} {t(lang, prezzi.kmInclusiGiorno ? 'km_note' : 'km_note_only', { km: prezzi.kmInclusiGiorno ?? '', price: prezzi.prezzoKmExtra.toLocaleString(lang === 'it' ? 'it-IT' : 'en-GB', { minimumFractionDigits: 2 }) })}</p>

    <h3 class="step">{t(lang, 'step2_title')}</h3>
    <div class="plans">
      {prezzi.piani.map((p: any) => (
        <div class={`plan plan-${p.id}`}>
          <h4>{t(lang, planKey(p.id))}</h4>
          <p class="plan-price">{p.supplementoGiorno ? <>+€{p.supplementoGiorno}<small>/{t(lang, 'per_day_short')}</small></> : t(lang, 'plan_included')}</p>
          <dl>
            <dt>{t(lang, 'plan_excess')}</dt><dd>{p.franchigia === 'azzerata' ? t(lang, 'excess_waived') : t(lang, 'excess_standard')}</dd>
            <dt>{t(lang, 'plan_deposit')}</dt><dd>€{extraFm(p.cauzione)}</dd>
            <dt>{t(lang, 'plan_driver_short')}</dt><dd>{p.secondoGuidatore ? '✓' : '—'}</dd>
          </dl>
        </div>
      ))}
    </div>
    <p class="note">{t(lang, 'insurance_note')}</p>

    <h3 class="step">{t(lang, 'step3_title')}</h3>
    <div class="fee">
      <div><strong>{prezzi.servizio[lang]}</strong><small>{t(lang, 'per_rental_once')}</small></div>
      <b>€{prezzi.servizio.importo}</b>
    </div>
    <p class="extras"><span>{t(lang, 'options_title')}:</span> {prezzi.extra.map((e, i) => <>{i > 0 && ' · '}{e[lang]} <strong>€{e.importo}</strong></>)}</p>
  </div>
</section>

<!-- CALCOLATORE + RICHIESTA -->
<section id="calcola" class="calc-section">
  <div class="wrap">
    <h2>{t(lang, 'calc_title')}</h2>
    {promo.attiva && (
      <p class="calc-promo" hidden data-from={promo.mostraDal} data-to={promo.mostraAl}>
        <strong>{promo.titolo[lang]}</strong> {t(lang, 'promo_valid', { a: fmtDate(promo.noleggiDal, lang), b: fmtDate(promo.noleggiAl, lang) })}
      </p>
    )}
    <form class="calc" id="calc" novalidate>
      <div class="calc-fields">
        <label>{t(lang, 'calc_pickup')}<input type="date" name="a" required /></label>
        <label>{t(lang, 'calc_return')}<input type="date" name="b" required /></label>
        <fieldset class="plan-pick">
          <legend>{t(lang, 'calc_plan')}</legend>
          {prezzi.piani.map((p, i) => (
            <label class="pill"><input type="radio" name="piano" value={p.id} checked={i === 1} /> {t(lang, planKey(p.id))}</label>
          ))}
        </fieldset>
        <label>{t(lang, 'calc_people')}
          <select name="persone">{[1, 2, 3, 4, 5].map((n) => <option selected={n === 2}>{n}</option>)}</select>
        </label>
        <label>{t(lang, 'calc_name')}<input type="text" name="nome" autocomplete="name" /></label>
        <fieldset class="extras-pick">
          <legend>{t(lang, 'calc_extras')}</legend>
          {prezzi.extra.map((e) => (
            <label class="check"><input type="checkbox" name="extra" value={e.id} /> {e[lang]} <small>€{e.importo}</small></label>
          ))}
        </fieldset>
        <label class="wide">{t(lang, 'calc_notes')}<textarea name="note" rows="2" placeholder={t(lang, 'calc_notes_ph')}></textarea></label>
      </div>
      <div class="calc-result" aria-live="polite">
        <div id="calc-lines" class="calc-lines"></div>
        <div class="calc-total"><span>{t(lang, 'calc_total')}</span><strong id="calc-total">—</strong></div>
        <div class="calc-deposit"><span>{t(lang, 'calc_deposit')}</span><span id="calc-deposit">—</span></div>
        <p id="calc-error" class="calc-error" hidden></p>
        <a id="calc-send" class="btn btn-wa calc-send" href={waUrl} target="_blank" rel="noopener">{t(lang, 'calc_send')}</a>
        <p class="calc-hint">{t(lang, 'calc_hint')}</p>
      </div>
    </form>

    <div id="disponibilita" class="avail">
      {info.calendarioEmbedUrl ? (
        <details>
          <summary>{t(lang, 'avail_show')}</summary>
          <p class="note">{t(lang, 'avail_sub')}</p>
          <iframe class="calendar" src={info.calendarioEmbedUrl} title={t(lang, 'avail_title')} loading="lazy"></iframe>
        </details>
      ) : (
        <p class="note">{t(lang, 'avail_missing')}</p>
      )}
    </div>
  </div>
</section>

<!-- GALLERIA: anteprima + visore a tutto schermo -->
<section id="galleria" class="gallery-section">
  <div class="wrap">
    <div class="head-row">
      <h2>{t(lang, 'gallery_title')}</h2>
      <button type="button" class="btn btn-ghost gal-open" data-i="0">{t(lang, 'gallery_all', { n: galleria.length })}</button>
    </div>
    <div class="gallery">
      {galleria.slice(0, 3).map((src, i) => (
        <button type="button" class="gal-thumb" data-i={i} aria-label={`${t(lang, 'gallery_photo')} ${i + 1}`}>
          <img src={src} alt="" loading="lazy" width="400" height="300" />
        </button>
      ))}
    </div>
  </div>
  <dialog class="lightbox" aria-label={t(lang, 'gallery_title')}>
    <img class="lb-img" alt="" />
    <button type="button" class="lb-btn lb-prev" aria-label={t(lang, 'gallery_prev')}>‹</button>
    <button type="button" class="lb-btn lb-next" aria-label={t(lang, 'gallery_next')}>›</button>
    <button type="button" class="lb-btn lb-close" aria-label={t(lang, 'gallery_close')}>×</button>
    <p class="lb-count"></p>
  </dialog>
  <script type="application/json" id="gal-data" set:html={JSON.stringify(galleria)} />
</section>

<!-- RITIRO E RICONSEGNA -->
<section id="ritiro" class="pickup">
  <div class="wrap">
    <h2>{t(lang, 'pickup_title')}</h2>
    <div class="pickup-grid">
      <div>
        <h3>{t(lang, 'pickup_where')}</h3>
        <p>{info.ritiro.indirizzo}<br /><a href={info.ritiro.mappaUrl} target="_blank" rel="noopener">{t(lang, 'contacts_map')} →</a></p>
        <h3>{t(lang, 'pickup_hours')}</h3>
        <p class="hours">{info.ritiro.orari}</p>
      </div>
      <div>
        <h3>{t(lang, 'pickup_return')}</h3>
        <ul class="ticks">{info.riconsegna[lang].map((v) => <li>{v}</li>)}</ul>
      </div>
    </div>
    <ul class="rules" aria-label={t(lang, 'rules_title')}>{info.regole.map((r) => <li>{r[lang]}</li>)}</ul>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="faq">
  <div class="wrap">
    <h2>{t(lang, 'faq_title')}</h2>
    {info.faq.filter((f) => !/DA_CONFERMARE|TO_CONFIRM/.test(f.it[1] + f.en[1])).map((f) => (
      <details>
        <summary>{f[lang][0]}</summary>
        <p>{f[lang][1]}</p>
      </details>
    ))}
  </div>
</section>

<!-- CONTATTI -->
<section id="contatti" class="contacts">
  <div class="wrap contacts-grid">
    <img class="contacts-logo" src={u('/assets/brand/logo.png')} alt="Mistralia" width="900" height="677" loading="lazy" />
    <div>
      <h2>{t(lang, 'contacts_title')}</h2>
      <p>{info.telefoni.map((tel) => (<><a href={`tel:${tel.replace(/\s/g, '')}`}>{tel}</a><br /></>))}
        <a href={`mailto:${info.email}`}>{info.email}</a></p>
      <p class="note">{t(lang, 'contacts_wa_note')}</p>
    </div>
  </div>
</section>

<script type="application/json" id="calc-data" set:html={JSON.stringify(calcData)} />

<script>
  type Season = 'B' | 'M' | 'A';
  const D = JSON.parse(document.getElementById('calc-data')!.textContent || '{}');
  const form = document.getElementById('calc') as HTMLFormElement;
  const out = {
    lines: document.getElementById('calc-lines')!,
    total: document.getElementById('calc-total')!,
    deposit: document.getElementById('calc-deposit')!,
    error: document.getElementById('calc-error')!,
    send: document.getElementById('calc-send') as HTMLAnchorElement,
  };
  const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
  const eur = (n: number) => '€' + Math.round(n).toLocaleString(D.lang === 'it' ? 'it-IT' : 'en-GB');
  const today = new Date().toISOString().slice(0, 10);

  // Diario: nasconde gli articoli con l'evento concluso e mostra i 3 più recenti rimasti
  {
    const cards = [...document.querySelectorAll<HTMLElement>('#diario .post-card')]
      .filter((c) => !c.dataset.scadenza || c.dataset.scadenza >= today);
    cards.slice(0, 3).forEach((c) => (c.hidden = false));
    if (!cards.length) {
      document.getElementById('diario')?.remove();
      document.querySelector<HTMLElement>('.nav-journal')?.setAttribute('hidden', '');
    }
  }
  const genericWa = out.send.href;

  // Mostra la riga promo nel calcolatore solo nelle date della promo
  const promoLine = document.querySelector<HTMLElement>('.calc-promo');
  const promoLive = D.promo.attiva && (!D.promo.mostraDal || today >= D.promo.mostraDal) && (!D.promo.mostraAl || today <= D.promo.mostraAl);
  if (promoLine && promoLive) promoLine.hidden = false;

  // Le date non possono essere nel passato
  form.querySelectorAll<HTMLInputElement>('input[type=date]').forEach((i) => (i.min = today));

  // Scelto il ritiro, la riconsegna parte da lì: minimo il giorno dopo e, se vuota, proposta con il noleggio minimo
  const inA = form.elements.namedItem('a') as HTMLInputElement;
  const inB = form.elements.namedItem('b') as HTMLInputElement;
  inA.addEventListener('change', () => {
    if (!inA.value) return;
    inB.min = addDay(inA.value);
    if (!inB.value || inB.value <= inA.value) {
      const exc = (D.minimoEccezioni || []).find((e: any) => inA.value >= e.dal && inA.value <= e.al);
      const minDays = exc ? exc.giorni : D.minimoGiorni[seasonOf(inA.value)];
      let d = inA.value;
      for (let i = 0; i < minDays; i++) d = addDay(d);
      inB.value = d;
    }
    update();
  });

  const years = Object.keys(D.stagioni).filter((k) => /^\d{4}$/.test(k)).sort();
  function seasonOf(iso: string): Season {
    const [y, m, d] = iso.split('-');
    const table = D.stagioni[y] ?? D.stagioni[years[years.length - 1]];
    const c = table?.[m]?.[Number(d) - 1];
    return c === 'B' || c === 'A' ? c : 'M';
  }
  function addDay(iso: string) {
    const dt = new Date(iso + 'T12:00:00Z');
    dt.setUTCDate(dt.getUTCDate() + 1);
    return dt.toISOString().slice(0, 10);
  }
  const fmt = (iso: string) => iso.split('-').reverse().join('/');

  function update() {
    const f = new FormData(form);
    const a = String(f.get('a') || ''), b = String(f.get('b') || '');
    const plan = D.piani.find((p: any) => p.id === f.get('piano')) ?? D.piani[0];
    out.deposit.textContent = eur(plan.cauzione);
    const fail = (msg: string) => {
      out.error.textContent = msg; out.error.hidden = !msg;
      out.lines.innerHTML = ''; out.total.textContent = '—'; out.send.href = genericWa;
    };
    if (!a || !b) return fail('');
    if (b <= a) return fail(D.txt.calc_err_order);

    const count: Record<Season, number> = { B: 0, M: 0, A: 0 };
    let n = 0;
    for (let d = a; d < b; d = addDay(d)) { count[seasonOf(d)]++; n++; }
    // Minimo di giorni: dipende dalla stagione del giorno di ritiro, salvo eccezioni per periodo
    const exc = (D.minimoEccezioni || []).find((e: any) => a >= e.dal && a <= e.al);
    const minDays = exc ? exc.giorni : D.minimoGiorni[seasonOf(a)];
    if (n < minDays) return fail(fill(D.txt.calc_err_min, { n: minDays }));
    out.error.hidden = true;

    const lines: [string, number][] = [];
    let total = 0;
    (['B', 'M', 'A'] as Season[]).forEach((s) => {
      if (!count[s]) return;
      const v = count[s] * D.prezzoGiorno[s];
      total += v;
      lines.push([fill(D.txt.calc_season_line, { n: count[s], s: D.txt['season_' + s].toLowerCase(), p: D.prezzoGiorno[s] }), v]);
    });
    if (plan.supplementoGiorno) {
      const v = n * plan.supplementoGiorno;
      total += v;
      lines.push([fill(D.txt.calc_plan_line, { plan: plan.nome, n, p: plan.supplementoGiorno }), v]);
    }
    const subtotalRent = total;
    const promoOk = promoLive && (!D.promo.noleggiDal || a >= D.promo.noleggiDal) && (!D.promo.noleggiAl || a <= D.promo.noleggiAl);
    if (promoOk && D.promo.sconto > 0) {
      const v = -Math.round((subtotalRent * D.promo.sconto) / 100);
      total += v;
      lines.push([fill(D.txt.calc_promo_line, { name: D.promo.nome, pct: D.promo.sconto }), v]);
    }

    // Quota fissa di servizio e extra scelti (non scontati)
    total += D.servizio.importo;
    lines.push([fill(D.txt.calc_service_line, { name: D.servizio.nome }), D.servizio.importo]);
    const chosen = D.extra.filter((e: any) => f.getAll('extra').includes(e.id));
    for (const e of chosen) { total += e.importo; lines.push([e.nome, e.importo]); }

    out.lines.innerHTML = '';
    for (const [label, v] of lines) {
      const row = document.createElement('div');
      const l = document.createElement('span'); l.textContent = label;
      const r = document.createElement('span'); r.textContent = (v < 0 ? '−' : '') + eur(Math.abs(v));
      if (v < 0) row.className = 'discount';
      row.append(l, r); out.lines.append(row);
    }
    out.total.textContent = eur(total);

    const msg = [
      D.txt.wa_hello,
      fill(D.txt.wa_dates, { a: fmt(a), b: fmt(b), n }),
      fill(D.txt.wa_plan, { plan: plan.nome }),
      fill(D.txt.wa_people, { n: String(f.get('persone')) }),
      fill(D.txt.wa_total, { t: Math.round(total) }),
      promoOk ? fill(D.txt.wa_promo, { name: D.promo.nome }) : '',
      chosen.length ? fill(D.txt.wa_extras, { list: chosen.map((e: any) => e.nome).join(', ') }) : '',
      f.get('nome') ? fill(D.txt.wa_name, { n: String(f.get('nome')) }) : '',
      f.get('note') ? fill(D.txt.wa_notes, { n: String(f.get('note')) }) : '',
    ].filter(Boolean).join('\n');
    out.send.href = `https://wa.me/${D.whatsapp}?text=${encodeURIComponent(msg)}`;
  }
  form.addEventListener('input', update);
  form.addEventListener('change', update);
  form.addEventListener('submit', (e) => e.preventDefault());
  update();
</script>

<script>
  // Galleria: anteprima di 3 foto, tutte le altre nel visore a tutto schermo (frecce, tastiera, swipe)
  const foto: string[] = JSON.parse(document.getElementById('gal-data')?.textContent || '[]');
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  if (dlg && foto.length) {
    const img = dlg.querySelector<HTMLImageElement>('.lb-img')!;
    const count = dlg.querySelector<HTMLElement>('.lb-count')!;
    let i = 0;
    const show = (n: number) => {
      i = (n + foto.length) % foto.length;
      img.src = foto[i];
      count.textContent = `${i + 1} / ${foto.length}`;
      new Image().src = foto[(i + 1) % foto.length]; // precarica la successiva
    };
    document.querySelectorAll<HTMLElement>('.gal-thumb, .gal-open').forEach((b) =>
      b.addEventListener('click', () => { show(Number(b.dataset.i || 0)); dlg.showModal(); }));
    dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('.lb-next')!.addEventListener('click', () => show(i + 1));
    dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    let x0 = 0;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(dx < 0 ? i + 1 : i - 1);
    });
  }
</script>

