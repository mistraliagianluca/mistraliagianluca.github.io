---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import { t, paths, prezzi, info, getPromo, prezzoMinimo, fmtDate, type Lang } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const promo = getPromo();
const waUrl = `https://wa.me/${info.whatsapp}?text=${encodeURIComponent(t(lang, 'wa_generic'))}`;

const posts = (await getCollection('diario', ({ data }) => data.lingua === lang))
  .sort((a, b) => b.data.data.getTime() - a.data.data.getTime())
  .slice(0, 3);

const seasons = ['B', 'M', 'A'] as const;

// Foto di apertura: numero della galleria oppure nome di un file in public/assets/gallery/
const galDir = 'public/assets/gallery';
let heroSrc = `/assets/gallery/${info.fotoAperturaRiserva}.jpg`;
if (typeof info.fotoApertura === 'number') heroSrc = `/assets/gallery/${info.fotoApertura}.jpg`;
else {
  const wanted = String(info.fotoApertura).toLowerCase();
  const found = fs.existsSync(galDir) ? fs.readdirSync(galDir).find((x) => x.toLowerCase() === wanted) : undefined;
  if (found) heroSrc = `/assets/gallery/${found}`;
}

// Periodi di ogni stagione, ricavati dal calendario dell'ultimo anno in prezzi.json
const stagioni = prezzi.stagioni as any;
const anni = Object.keys(stagioni).filter((k) => /^\d{4}$/.test(k)).sort();
const annoPeriodi = anni[anni.length - 1];
const periodi: Record<string, string[]> = { B: [], M: [], A: [] };
{
  const fmtD = (d: Date) => d.toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
  let cur = '', start: Date | null = null, prev: Date | null = null;
  const close = () => { if (cur && start && prev) periodi[cur].push(start.getTime() === prev.getTime() ? fmtD(start) : `${fmtD(start)} – ${fmtD(prev)}`); };
  for (let m = 1; m <= 12; m++) {
    const row: string = stagioni[annoPeriodi][String(m).padStart(2, '0')] ?? '';
    for (let d = 1; d <= row.length; d++) {
      const c = row[d - 1];
      const date = new Date(Date.UTC(Number(annoPeriodi), m - 1, d));
      if (c !== cur) { close(); cur = c; start = date; }
      prev = date;
    }
  }
  close();
}
const planKey = (id: string) => `plan_${id}`;

// Dati per il calcolatore (letti dallo script nel browser)
const calcData = {
  lang,
  whatsapp: info.whatsapp,
  prezzoGiorno: prezzi.prezzoGiorno,
  minimoGiorni: prezzi.minimoGiorni,
  minimoEccezioni: prezzi.minimoEccezioni,
  stagioni: prezzi.stagioni,
  piani: prezzi.piani.map((p) => ({ ...p, nome: t(lang, planKey(p.id)) })),
  servizio: { importo: prezzi.servizio.importo, nome: prezzi.servizio[lang] },
  extra: prezzi.extra.map((e) => ({ id: e.id, importo: e.importo, nome: e[lang] })),
  promo,
  txt: Object.fromEntries(
    ['season_B', 'season_M', 'season_A', 'calc_days', 'calc_season_line', 'calc_plan_line', 'calc_promo_line',
     'calc_err_dates', 'calc_err_order', 'calc_err_min', 'wa_hello', 'wa_dates', 'wa_plan', 'wa_people',
     'wa_total', 'wa_promo', 'wa_name', 'wa_notes', 'calc_service_line', 'wa_extras'].map((k) => [k, t(lang, k)]),
  ),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Mistralia – Noleggio camper',
  url: 'https://www.mistralia.co/',
  telephone: info.telefoni[0],
  email: info.email,
  address: { '@type': 'PostalAddress', streetAddress: 'Strada Statale 96, km 115,500', postalCode: '70026', addressLocality: 'Modugno', addressRegion: 'BA', addressCountry: 'IT' },
  priceRange: `€${prezzoMinimo}–€${Math.max(...Object.values(prezzi.prezzoGiorno))} / giorno`,
};
---
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<!-- APERTURA -->
<section class="hero">
  <div class="wrap hero-grid">
    <img class="hero-logo" src="/assets/brand/logo.png" alt="Mistralia" width="900" height="677" />
    <div class="hero-text">
      <p class="eyebrow">{t(lang, 'kicker')}</p>
      <h1>{t(lang, 'hero_title')}</h1>
      <p class="hero-sub">{t(lang, 'hero_sub')}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#calcola">{t(lang, 'cta_quote')}</a>
        <a class="btn btn-wa" href={waUrl} target="_blank" rel="noopener">{t(lang, 'cta_whatsapp')}</a>
      </div>
      <p class="from-price">{t(lang, 'from_price', { p: prezzoMinimo })}</p>
    </div>
    <div class="hero-photo">
      <img src={heroSrc} alt="Kentucky" width="1264" height="848" fetchpriority="high" />
      <div class="hero-badge">
        <strong>{lang === 'it' ? 'Tutto incluso' : 'All inclusive'}</strong>
        <span>{lang === 'it' ? 'tranne le lenzuola' : 'except the sheets'}</span>
      </div>
    </div>
  </div>
</section>

<!-- PERCHÉ -->
<section id="perche" class="why">
  <div class="wrap">
    <h2>{t(lang, 'why_title')}</h2>
    <div class="cards3">
      {[1, 2, 3].map((n) => (
        <article class="card">
          <span class="card-num">{n}</span>
          <h3>{t(lang, `why_${n}_t`)}</h3>
          <p>{t(lang, `why_${n}_b`)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- COSA È INCLUSO -->
<section id="incluso" class="included">
  <div class="wrap">
    <h2>{t(lang, 'included_title')}</h2>
    <p class="section-sub">{t(lang, 'included_sub')}</p>
    <div class="kit">
      {info.kit.map((k) => (
        <div class="kit-item">
          <h3>{k.titolo[lang]}</h3>
          <p>{k.voci[lang]}</p>
        </div>
      ))}
    </div>
    <div class="prep">
      <div>
        <h3>{t(lang, 'prep_title')}</h3>
        <p>{t(lang, 'prep_sub', { p: prezzi.servizio.importo })}</p>
      </div>
      <ul class="checklist">
        {info.preparazione[lang].map((v) => <li>{v}</li>)}
      </ul>
    </div>
  </div>
</section>

<!-- PREZZI -->
<section id="prezzi" class="prices">
  <div class="wrap">
    <h2>{t(lang, 'prices_title')}</h2>
    <p class="section-sub">{t(lang, 'prices_sub')}</p>
    <h3 class="step-title">{t(lang, 'step1_title')}</h3>
    <div class="season-rows">
      {seasons.map((s) => (
        <div class={`season-row season-${s}`}>
          <div class="season-name"><i></i>{t(lang, `season_${s}`)} <span>{t(lang, 'season_label')}</span></div>
          <div class="season-dates"><small>{t(lang, 'periods_label', { y: annoPeriodi })}</small>{periodi[s].join(' · ')}</div>
          <div class="season-price"><strong>€{prezzi.prezzoGiorno[s]}</strong><small>{t(lang, 'per_day')}</small></div>
        </div>
      ))}
    </div>
    <p class="price-notes">{t(lang, 'min_days')} {t(lang, 'km_note', { km: prezzi.kmInclusiGiorno, price: prezzi.prezzoKmExtra.toLocaleString(lang === 'it' ? 'it-IT' : 'en-GB', { minimumFractionDigits: 2 }) })}</p>

    <h3 class="step-title">{t(lang, 'step2_title')}</h3>
    <p class="step-sub">{t(lang, 'step2_sub')} {t(lang, 'insurance_note')}</p>
    <div class="plan-table-wrap">
      <table class="plan-table">
        <thead>
          <tr><th></th>{prezzi.piani.map((p) => <th class={`pt-${p.id}`}>{t(lang, planKey(p.id))}</th>)}</tr>
        </thead>
        <tbody>
          <tr><th>{t(lang, 'plan_supplement')}</th>{prezzi.piani.map((p) => <td>{p.supplementoGiorno ? `+€${p.supplementoGiorno} ${t(lang, 'per_day')}` : t(lang, 'plan_included')}</td>)}</tr>
          <tr><th>{t(lang, 'plan_excess')}</th>{prezzi.piani.map((p) => <td>{p.franchigia === 'azzerata' ? t(lang, 'excess_waived') : t(lang, 'excess_standard')}</td>)}</tr>
          <tr><th>{t(lang, 'plan_deposit')}</th>{prezzi.piani.map((p) => <td>€{p.cauzione.toLocaleString(lang === 'it' ? 'it-IT' : 'en-GB')}</td>)}</tr>
          <tr><th>{t(lang, 'plan_driver')}</th>{prezzi.piani.map((p) => <td>{(p as any).secondoGuidatore ? t(lang, 'driver_yes') : t(lang, 'driver_no')}</td>)}</tr>
        </tbody>
      </table>
    </div>

    <h3 class="step-title">{t(lang, 'step3_title')}</h3>
    <div class="fee-box">
      <div><strong>{prezzi.servizio[lang]}</strong><small>{t(lang, 'per_rental_once')}</small></div>
      <b>€{prezzi.servizio.importo}</b>
    </div>

    <h3 class="step-title">{t(lang, 'options_title')}</h3>
    <ul class="options">
      {prezzi.extra.map((e) => <li><span>{e[lang]}</span><strong>€{e.importo}</strong></li>)}
    </ul>
  </div>
</section>

<!-- CALCOLATORE + RICHIESTA -->
<section id="calcola" class="calc-section">
  <div class="wrap">
    <h2>{t(lang, 'calc_title')}</h2>
    {promo.attiva && (
      <p class="calc-promo" hidden data-from={promo.mostraDal} data-to={promo.mostraAl}>
        {promo.titolo[lang]} · {t(lang, 'promo_valid', { a: fmtDate(promo.noleggiDal, lang), b: fmtDate(promo.noleggiAl, lang) })}
      </p>
    )}
    <form class="calc" id="calc" novalidate>
      <div class="calc-fields">
        <label>{t(lang, 'calc_pickup')}<input type="date" name="a" required /></label>
        <label>{t(lang, 'calc_return')}<input type="date" name="b" required /></label>
        <fieldset class="plan-pick">
          <legend>{t(lang, 'calc_plan')}</legend>
          {prezzi.piani.map((p, i) => (
            <label class="pill"><input type="radio" name="piano" value={p.id} checked={i === 1} /> {t(lang, planKey(p.id))}</label>
          ))}
        </fieldset>
        <label>{t(lang, 'calc_people')}
          <select name="persone">{[1, 2, 3, 4, 5].map((n) => <option selected={n === 2}>{n}</option>)}</select>
        </label>
        <label>{t(lang, 'calc_name')}<input type="text" name="nome" autocomplete="name" /></label>
        <fieldset class="extras-pick">
          <legend>{t(lang, 'calc_extras')}</legend>
          {prezzi.extra.map((e) => (
            <label class="check"><input type="checkbox" name="extra" value={e.id} /> {e[lang]} <small>€{e.importo}</small></label>
          ))}
        </fieldset>
        <label class="wide">{t(lang, 'calc_notes')}<textarea name="note" rows="2" placeholder={t(lang, 'calc_notes_ph')}></textarea></label>
      </div>
      <div class="calc-result" aria-live="polite">
        <div id="calc-lines" class="calc-lines"></div>
        <div class="calc-total"><span>{t(lang, 'calc_total')}</span><strong id="calc-total">—</strong></div>
        <div class="calc-deposit"><span>{t(lang, 'calc_deposit')}</span><span id="calc-deposit">—</span></div>
        <p id="calc-error" class="calc-error" hidden></p>
        <a id="calc-send" class="btn btn-wa calc-send" href={waUrl} target="_blank" rel="noopener">{t(lang, 'calc_send')}</a>
        <p class="calc-hint">{t(lang, 'calc_hint')}</p>
      </div>
    </form>
  </div>
</section>

<!-- DISPONIBILITÀ -->
<section id="disponibilita" class="availability">
  <div class="wrap">
    <h2>{t(lang, 'avail_title')}</h2>
    {info.calendarioEmbedUrl ? (
      <>
        <p class="section-sub">{t(lang, 'avail_sub')}</p>
        <iframe class="calendar" src={info.calendarioEmbedUrl} title={t(lang, 'avail_title')} loading="lazy"></iframe>
      </>
    ) : (
      <div class="avail-missing">
        <p>{t(lang, 'avail_missing')}</p>
        <a class="btn btn-wa" href={waUrl} target="_blank" rel="noopener">{t(lang, 'cta_whatsapp')}</a>
      </div>
    )}
  </div>
</section>

<!-- GALLERIA -->
<section id="galleria" class="gallery-section">
  <div class="wrap">
    <h2>{t(lang, 'gallery_title')}</h2>
    <div class="gallery">
      {info.galleria.map((n) => (
        <a href={`/assets/gallery/${n}.jpg`} target="_blank" rel="noopener">
          <img src={`/assets/gallery/${n}.jpg`} alt={`Kentucky ${n}`} loading="lazy" width="400" height="300" />
        </a>
      ))}
    </div>
  </div>
</section>

<!-- DIARIO -->
{posts.length > 0 && (
  <section id="diario" class="journal">
    <div class="wrap">
      <h2>{t(lang, 'journal_title')}</h2>
      <p class="section-sub">{t(lang, 'journal_sub')}</p>
      <div class="cards3">
        {posts.map((p) => (
          <a class="post-card" href={paths.post(lang, p.data.chiave)}>
            <img src={p.data.immagine} alt="" loading="lazy" width="400" height="225" />
            <div>
              <small>{fmtDate(p.data.data, lang)}</small>
              <h3>{p.data.titolo}</h3>
              <p>{p.data.estratto}</p>
              <span class="read-more">{t(lang, 'journal_all')} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- RITIRO E RICONSEGNA -->
<section id="ritiro" class="pickup">
  <div class="wrap">
    <h2>{t(lang, 'pickup_title')}</h2>
    <div class="pickup-grid">
      <div class="pickup-card">
        <h3>{t(lang, 'pickup_where')}</h3>
        <p>{info.ritiro.indirizzo}</p>
        <a class="btn btn-ghost" href={info.ritiro.mappaUrl} target="_blank" rel="noopener">{t(lang, 'contacts_map')}</a>
      </div>
      <div class="pickup-card">
        <h3>{t(lang, 'pickup_hours')}</h3>
        <p class="hours">{info.ritiro.orari}</p>
      </div>
      <div class="pickup-card">
        <h3>{t(lang, 'pickup_return')}</h3>
        <ul class="checklist">{info.riconsegna[lang].map((v) => <li>{v}</li>)}</ul>
      </div>
    </div>
    <h3 class="rules-title">{t(lang, 'rules_title')}</h3>
    <ul class="rules">{info.regole.map((r) => <li>{r[lang]}</li>)}</ul>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="faq">
  <div class="wrap">
    <h2>{t(lang, 'faq_title')}</h2>
    {info.faq.map((f) => (
      <details>
        <summary>{f[lang][0]}</summary>
        <p>{f[lang][1]}</p>
      </details>
    ))}
  </div>
</section>

<!-- CONTATTI -->
<section id="contatti" class="contacts">
  <div class="wrap contacts-grid">
    <div class="contacts-logo"><img src="/assets/brand/logo.png" alt="Mistralia" width="900" height="677" loading="lazy" /></div>
    <div>
      <h2>{t(lang, 'contacts_title')}</h2>
      <h3>{t(lang, 'contacts_where')}</h3>
      <p>{info.ritiro.indirizzo}<br /><a href={info.ritiro.mappaUrl} target="_blank" rel="noopener">{t(lang, 'contacts_map')}</a></p>
      <h3>{t(lang, 'contacts_phone')}</h3>
      <p>{info.telefoni.map((tel) => (<><a href={`tel:${tel.replace(/\s/g, '')}`}>{tel}</a><br /></>))}
        <a href={`mailto:${info.email}`}>{info.email}</a></p>
      <a class="btn btn-wa" href={waUrl} target="_blank" rel="noopener">{t(lang, 'cta_whatsapp')}</a>
    </div>
  </div>
</section>

<script type="application/json" id="calc-data" set:html={JSON.stringify(calcData)} />

<script>
  type Season = 'B' | 'M' | 'A';
  const D = JSON.parse(document.getElementById('calc-data')!.textContent || '{}');
  const form = document.getElementById('calc') as HTMLFormElement;
  const out = {
    lines: document.getElementById('calc-lines')!,
    total: document.getElementById('calc-total')!,
    deposit: document.getElementById('calc-deposit')!,
    error: document.getElementById('calc-error')!,
    send: document.getElementById('calc-send') as HTMLAnchorElement,
  };
  const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
  const eur = (n: number) => '€' + Math.round(n).toLocaleString(D.lang === 'it' ? 'it-IT' : 'en-GB');
  const today = new Date().toISOString().slice(0, 10);
  const genericWa = out.send.href;

  // Mostra la riga promo nel calcolatore solo nelle date della promo
  const promoLine = document.querySelector<HTMLElement>('.calc-promo');
  const promoLive = D.promo.attiva && (!D.promo.mostraDal || today >= D.promo.mostraDal) && (!D.promo.mostraAl || today <= D.promo.mostraAl);
  if (promoLine && promoLive) promoLine.hidden = false;

  // Le date non possono essere nel passato
  form.querySelectorAll<HTMLInputElement>('input[type=date]').forEach((i) => (i.min = today));

  const years = Object.keys(D.stagioni).filter((k) => /^\d{4}$/.test(k)).sort();
  function seasonOf(iso: string): Season {
    const [y, m, d] = iso.split('-');
    const table = D.stagioni[y] ?? D.stagioni[years[years.length - 1]];
    const c = table?.[m]?.[Number(d) - 1];
    return c === 'B' || c === 'A' ? c : 'M';
  }
  function addDay(iso: string) {
    const dt = new Date(iso + 'T12:00:00Z');
    dt.setUTCDate(dt.getUTCDate() + 1);
    return dt.toISOString().slice(0, 10);
  }
  const fmt = (iso: string) => iso.split('-').reverse().join('/');

  function update() {
    const f = new FormData(form);
    const a = String(f.get('a') || ''), b = String(f.get('b') || '');
    const plan = D.piani.find((p: any) => p.id === f.get('piano')) ?? D.piani[0];
    out.deposit.textContent = eur(plan.cauzione);
    const fail = (msg: string) => {
      out.error.textContent = msg; out.error.hidden = !msg;
      out.lines.innerHTML = ''; out.total.textContent = '—'; out.send.href = genericWa;
    };
    if (!a || !b) return fail('');
    if (b <= a) return fail(D.txt.calc_err_order);

    const count: Record<Season, number> = { B: 0, M: 0, A: 0 };
    let n = 0;
    for (let d = a; d < b; d = addDay(d)) { count[seasonOf(d)]++; n++; }
    // Minimo di giorni: dipende dalla stagione del giorno di ritiro, salvo eccezioni per periodo
    const exc = (D.minimoEccezioni || []).find((e: any) => a >= e.dal && a <= e.al);
    const minDays = exc ? exc.giorni : D.minimoGiorni[seasonOf(a)];
    if (n < minDays) return fail(fill(D.txt.calc_err_min, { n: minDays }));
    out.error.hidden = true;

    const lines: [string, number][] = [];
    let total = 0;
    (['B', 'M', 'A'] as Season[]).forEach((s) => {
      if (!count[s]) return;
      const v = count[s] * D.prezzoGiorno[s];
      total += v;
      lines.push([fill(D.txt.calc_season_line, { n: count[s], s: D.txt['season_' + s].toLowerCase(), p: D.prezzoGiorno[s] }), v]);
    });
    if (plan.supplementoGiorno) {
      const v = n * plan.supplementoGiorno;
      total += v;
      lines.push([fill(D.txt.calc_plan_line, { plan: plan.nome, n, p: plan.supplementoGiorno }), v]);
    }
    const subtotalRent = total;
    const promoOk = promoLive && (!D.promo.noleggiDal || a >= D.promo.noleggiDal) && (!D.promo.noleggiAl || a <= D.promo.noleggiAl);
    if (promoOk && D.promo.sconto > 0) {
      const v = -Math.round((subtotalRent * D.promo.sconto) / 100);
      total += v;
      lines.push([fill(D.txt.calc_promo_line, { name: D.promo.nome, pct: D.promo.sconto }), v]);
    }

    // Quota fissa di servizio e extra scelti (non scontati)
    total += D.servizio.importo;
    lines.push([fill(D.txt.calc_service_line, { name: D.servizio.nome }), D.servizio.importo]);
    const chosen = D.extra.filter((e: any) => f.getAll('extra').includes(e.id));
    for (const e of chosen) { total += e.importo; lines.push([e.nome, e.importo]); }

    out.lines.innerHTML = '';
    for (const [label, v] of lines) {
      const row = document.createElement('div');
      const l = document.createElement('span'); l.textContent = label;
      const r = document.createElement('span'); r.textContent = (v < 0 ? '−' : '') + eur(Math.abs(v));
      if (v < 0) row.className = 'discount';
      row.append(l, r); out.lines.append(row);
    }
    out.total.textContent = eur(total);

    const msg = [
      D.txt.wa_hello,
      fill(D.txt.wa_dates, { a: fmt(a), b: fmt(b), n }),
      fill(D.txt.wa_plan, { plan: plan.nome }),
      fill(D.txt.wa_people, { n: String(f.get('persone')) }),
      fill(D.txt.wa_total, { t: Math.round(total) }),
      promoOk ? fill(D.txt.wa_promo, { name: D.promo.nome }) : '',
      chosen.length ? fill(D.txt.wa_extras, { list: chosen.map((e: any) => e.nome).join(', ') }) : '',
      f.get('nome') ? fill(D.txt.wa_name, { n: String(f.get('nome')) }) : '',
      f.get('note') ? fill(D.txt.wa_notes, { n: String(f.get('note')) }) : '',
    ].filter(Boolean).join('\n');
    out.send.href = `https://wa.me/${D.whatsapp}?text=${encodeURIComponent(msg)}`;
  }
  form.addEventListener('input', update);
  form.addEventListener('change', update);
  form.addEventListener('submit', (e) => e.preventDefault());
  update();
</script>

<style>
  .hero { padding: 36px 0 72px; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; grid-template-areas: 'logo photo' 'text photo'; gap: 20px 48px; align-items: center; }
  .hero-logo { grid-area: logo; width: min(360px, 80%); align-self: end; }
