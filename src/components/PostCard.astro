---
// Scheda di un articolo del Diario, uguale in home e nella pagina Diario.
// Telefono: riga compatta (miniatura + titolo). Computer: scheda con immagine, categoria, titolo ed estratto.
// L'articolo della promo del momento (promo) può essere messo "in evidenza" dallo script della pagina
// (classe .in-evidenza): diventa più grande e mostra il testo del banner della promo.
import type { CollectionEntry } from 'astro:content';
import { t, paths, fmtDate, u, isoData, versionata, categoriaDi, ICONE_CATEGORIA, getPromo, type Lang } from '../lib/site';

interface Props { post: CollectionEntry<'diario'>; lang: Lang; promo?: boolean; h?: 'h2' | 'h3' }
const { post, lang, promo = false, h = 'h3' } = Astro.props;
const cat = categoriaDi(post.data);
const Titolo = h;
const p = getPromo();
---
<a class="post-card" href={paths.post(lang, post.data.chiave)} data-scadenza={isoData(post.data.scadenza)} data-cat={cat} data-promo={promo ? '1' : undefined} hidden>
  <img src={u(versionata(post.data.immagine))} alt="" loading="lazy" width="400" height="225" />
  <div class="testo">
    <span class="riga"><span class={`cat cat-${cat}`}>{ICONE_CATEGORIA[cat]} {t(lang, `cat_${cat}`)}</span><small>{fmtDate(post.data.data, lang)}</small></span>
    {promo && <strong class="promo-tag">{p.titolo[lang]}</strong>}
    <Titolo>{post.data.titolo}</Titolo>
    <p>{post.data.estratto}</p>
  </div>
</a>

<style>
  .post-card { text-decoration: none; color: var(--ink); background: var(--white); border-radius: 12px; overflow: hidden; display: grid; grid-template-columns: 64px minmax(0, 1fr); align-items: center; box-shadow: 0 2px 10px rgba(12, 75, 66, 0.06); }
  .post-card[hidden] { display: none; }
  img { width: 64px; height: 64px; object-fit: cover; display: block; }
  .testo { padding: 8px 12px; min-width: 0; }
  .riga { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .cat { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; color: var(--green); }
  .cat-offerta { color: #b4461b; }
  small { color: var(--muted); font-size: 0.75rem; }
  h2, h3 { font-family: var(--body); font-weight: 800; font-size: 0.95rem; margin: 2px 0 0; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  p { display: none; }
  .promo-tag { display: none; }

  /* In evidenza: l'articolo dell'offerta del momento, in cima */
  .post-card.in-evidenza { grid-template-columns: minmax(0, 1fr); border: 2px solid var(--yellow); }
  .in-evidenza img { width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .in-evidenza .testo { padding: 12px 14px 14px; }
  .in-evidenza .promo-tag { display: inline-block; background: var(--yellow); color: var(--green); border-radius: 8px; padding: 4px 10px; font-size: 0.85rem; margin: 6px 0 2px; }
  .in-evidenza h2, .in-evidenza h3 { font-size: 1.1rem; -webkit-line-clamp: 3; }
  .in-evidenza p { display: block; color: var(--muted); font-size: 0.9rem; margin: 4px 0 0; }

  .post-card.concluso { opacity: 0.75; }

  @media (min-width: 821px) {
    .post-card { grid-template-columns: minmax(0, 1fr); align-items: stretch; align-content: start; border-radius: 14px; }
    img { width: 100%; height: auto; aspect-ratio: 16 / 9; }
    .testo { padding: 14px 16px 16px; }
    h2, h3 { font-size: 1.02rem; }
    p { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; color: var(--muted); font-size: 0.9rem; margin: 4px 0 0; }
    .post-card.in-evidenza { grid-column: 1 / -1; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; }
    .in-evidenza img { height: 100%; }
    .in-evidenza .testo { padding: 20px 24px; }
    .in-evidenza h2, .in-evidenza h3 { font-size: 1.4rem; }
  }
</style>
