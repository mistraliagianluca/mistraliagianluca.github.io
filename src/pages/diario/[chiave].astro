---
import { getCollection } from 'astro:content';
import Post from '../../components/Post.astro';

export async function getStaticPaths() {
  const posts = await getCollection('diario', ({ data }) => data.lingua === 'it' && !data.esempio && !data.nascosto);
  return posts.map((post) => ({ params: { chiave: post.data.chiave }, props: { post } }));
}
const { post } = Astro.props;
---
<Post post={post} lang="it" />
